@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix mlact: <https://w3id.org/ogc/rim/ml-activity/> .
@prefix mlm:   <https://w3id.org/ogc/stac/mlm/> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix acttype: <https://w3id.org/ogc/rim/activity-type/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

# Additive profile shapes: an mlact:MLActivity is still a rim:RegisterAction
# (the base shapes.shacl continues to apply — sh:targetClass follows
# rdfs:subClassOf, so rim:RegisterActionShape's constraints, including the
# required rim:actionType, also fire on these nodes). These shapes add the
# ML-specific requirements: a model, a task drawn from the closed MLM task
# list, and at least one typed input and output.

mlact:MLActivityShape a sh:NodeShape ;
    sh:targetClass mlact:MLActivity ;
    sh:property [
        sh:path mlact:model ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path mlact:performsTask ;
        sh:minCount 1 ;
        sh:in (
            mlm:regression mlm:classification mlm:scene-classification mlm:detection
            mlm:object-detection mlm:segmentation mlm:semantic-segmentation
            mlm:instance-segmentation mlm:panoptic-segmentation mlm:similarity-search
            mlm:generative mlm:image-captioning mlm:super-resolution mlm:downscaling
        ) ;
    ] ;
    sh:property [
        sh:path mlact:framework ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path mlact:accelerator ;
        sh:in (
            mlm:amd64 mlm:cuda mlm:xla mlm:amd-rocm mlm:intel-ipex-cpu mlm:intel-ipex-gpu mlm:macos-arm
        ) ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path mlact:input ;
        sh:class mlact:ActivityInput ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path mlact:output ;
        sh:class mlact:ActivityOutput ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path prov:startedAtTime ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path prov:endedAtTime ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] .

mlact:ActivityInputShape a sh:NodeShape ;
    sh:targetClass mlact:ActivityInput ;
    sh:property [
        sh:path dct:conformsTo ;
        sh:class mlm:ModelInput ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path mlact:structure ;
        sh:class mlm:InputStructure ;
        sh:maxCount 1 ;
    ] .

mlact:ActivityOutputShape a sh:NodeShape ;
    sh:targetClass mlact:ActivityOutput ;
    sh:property [
        sh:path dct:conformsTo ;
        sh:class mlm:ModelOutput ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path mlact:structure ;
        sh:class mlm:ResultStructure ;
        sh:maxCount 1 ;
    ] .

# Activity-type-level shapes. The Geoprocessing Activity Types Profile's shapes
# still apply to registered ML activity types (mlact:MLActivity is a
# geoproc:GeoprocessingActivity); these narrow the related PROV object
# types further. Sub-classes that are not registered as
# acttype:ActivityType are skipped by the sh:not branch.

# A registered ML activity type uses at least one mlact:ActivityInput type.
mlact:MLActivityTypeShape a sh:NodeShape ;
    sh:property [
        sh:path acttype:usedEntityType ;
        sh:qualifiedValueShape [
            sh:property [ sh:path [ sh:zeroOrMorePath rdfs:subClassOf ] ; sh:hasValue mlact:ActivityInput ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "An ML activity type must declare at least one acttype:usedEntityType that is mlact:ActivityInput or a sub-class of it." ;
    ] .

# A registered inference activity type also generates at least one
# mlact:ActivityOutput type.
mlact:InferenceActivityTypeShape a sh:NodeShape ;
    sh:property [
        sh:path acttype:generatedEntityType ;
        sh:qualifiedValueShape [
            sh:property [ sh:path [ sh:zeroOrMorePath rdfs:subClassOf ] ; sh:hasValue mlact:ActivityOutput ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "An inference activity type must declare at least one acttype:generatedEntityType that is mlact:ActivityOutput or a sub-class of it." ;
    ] .

mlact:MLActivityTypesShape a sh:NodeShape ;
    sh:targetNode mlact:MLActivity ;
    sh:property [
        sh:path [ sh:zeroOrMorePath [ sh:inversePath rdfs:subClassOf ] ] ;
        sh:node [ sh:or ( [ sh:not [ sh:class acttype:ActivityType ] ] mlact:MLActivityTypeShape ) ] ;
    ] .

mlact:InferenceActivityTypesShape a sh:NodeShape ;
    sh:targetNode mlact:InferenceActivity ;
    sh:property [
        sh:path [ sh:zeroOrMorePath [ sh:inversePath rdfs:subClassOf ] ] ;
        sh:node [ sh:or ( [ sh:not [ sh:class acttype:ActivityType ] ] mlact:InferenceActivityTypeShape ) ] ;
    ] .
