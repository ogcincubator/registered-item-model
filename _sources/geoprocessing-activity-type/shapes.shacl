@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix geoproc: <https://w3id.org/ogc/rim/geoprocessing/> .
@prefix acttype: <https://w3id.org/ogc/rim/activity-type/> .
@prefix geo:     <http://www.opengis.net/ont/geosparql#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .

# Constrained profile shapes. The Activity Type Register Profile's shapes
# still apply to every registered type; these add geoprocessing-specific
# constraints on the related PROV object types that a registered
# sub-class of geoproc:GeoprocessingActivity must declare.

# A class is a spatial data type if it is, or specialises, one of the
# GeoSPARQL spatial classes. The sub-classes of geo:SpatialObject and
# geo:SpatialObjectCollection are listed as well, so the check still
# works when the GeoSPARQL ontology itself is not in the data graph.
geoproc:SpatialDataTypeShape a sh:NodeShape ;
    sh:property [
        sh:path [ sh:zeroOrMorePath rdfs:subClassOf ] ;
        sh:qualifiedValueShape [
            sh:in ( geo:SpatialObject geo:Feature geo:Geometry
                    geo:SpatialObjectCollection geo:FeatureCollection geo:GeometryCollection )
        ] ;
        sh:qualifiedMinCount 1 ;
    ] .

# A registered geoprocessing activity type uses or generates at least one
# spatial data type.
geoproc:GeoprocessingActivityTypeShape a sh:NodeShape ;
    sh:or (
        [ sh:property [
            sh:path acttype:usedEntityType ;
            sh:qualifiedValueShape geoproc:SpatialDataTypeShape ;
            sh:qualifiedMinCount 1 ;
        ] ]
        [ sh:property [
            sh:path acttype:generatedEntityType ;
            sh:qualifiedValueShape geoproc:SpatialDataTypeShape ;
            sh:qualifiedMinCount 1 ;
        ] ]
    ) ;
    sh:message "A geoprocessing activity type must declare at least one acttype:usedEntityType or acttype:generatedEntityType that is a GeoSPARQL spatial object or spatial object collection type." .

# Applies the constraints to every sub-class of geoproc:GeoprocessingActivity
# that is registered as an acttype:ActivityType. Sub-classes only declared
# in an ontology, and not registered, are skipped by the sh:not branch.
geoproc:GeoprocessingActivityTypesShape a sh:NodeShape ;
    sh:targetNode geoproc:GeoprocessingActivity ;
    sh:property [
        sh:path [ sh:oneOrMorePath [ sh:inversePath rdfs:subClassOf ] ] ;
        sh:node [
            sh:or (
                [ sh:not [ sh:class acttype:ActivityType ] ]
                geoproc:GeoprocessingActivityTypeShape
            )
        ] ;
    ] .
