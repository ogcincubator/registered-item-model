@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dct:     <http://purl.org/dc/terms/> .
@prefix rim:     <https://w3id.org/ogc/rim/> .

# Top-level catalog of the Registered Item Model, so that the model and its profiles can be browsed
# (catalog > ontology / concept scheme > classes, properties, concepts). Ontologies are linked with
# dct:hasPart; their classes and properties point back to them with rdfs:isDefinedBy.
<https://w3id.org/ogc/rim/catalog> a dcat:Catalog ;
    dct:title "Registered Item Model" ;
    dct:description "A base RDF/OWL and SHACL model for register items, register item classes and register governance metadata, aligned with ISO 19135:2026 and its controlled vocabularies. Its activity type, geoprocessing and machine learning profiles are published in the Activity Types Register."@en ;
    dct:hasPart rim:,
        rim:ValidityStatusScheme,
        rim:PublicationStatusScheme,
        rim:RegisterActionTypeScheme,
        rim:ChangeClassificationScheme,
        rim:CommitmentCategoryScheme .
