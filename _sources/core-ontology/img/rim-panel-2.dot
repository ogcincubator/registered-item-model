digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.42", ranksep="1.0", splines=true];
node [shape=ellipse, fontname="Arial", fontsize=19, color="#48515a", fontcolor="#353c43", penwidth=1.3, margin="0.18,0.12"];
edge [fontname="Arial", fontsize=15, color="#48515a", fontcolor="#24292e", penwidth=1.1, arrowhead=vee, arrowsize=0.75];
"https://w3id.org/ogc/rim/RegisterItem" [label="Register item", shape=ellipse];
"https://w3id.org/ogc/rim/Register" [label="Register", shape=ellipse];
"https://w3id.org/ogc/rim/RegisterItemClass" [label="Register item class", shape=ellipse];
"http://www.w3.org/2000/01/rdf-schema#Resource" [label="rdfs:Resource", shape=ellipse];
"https://w3id.org/ogc/rim/RegisterItem-other" [label="Register item", shape=ellipse];
"https://w3id.org/ogc/rim/ConceptVersion" [label="Concept version", shape=ellipse];
"https://w3id.org/ogc/rim/Concept" [label="Concept", shape=ellipse];
"https://w3id.org/ogc/rim/ConceptSystem" [label="Concept system", shape=ellipse];
"https://w3id.org/ogc/rim/RegisterItem" -> "https://w3id.org/ogc/rim/Register" [label="in register"];
"https://w3id.org/ogc/rim/RegisterItemClass" -> "https://w3id.org/ogc/rim/Register" [label="defined in"];
"https://w3id.org/ogc/rim/RegisterItem" -> "https://w3id.org/ogc/rim/RegisterItemClass" [label="item class"];
"https://w3id.org/ogc/rim/RegisterItemClass" -> "http://www.w3.org/2000/01/rdf-schema#Resource" [label="validated by"];
"https://w3id.org/ogc/rim/RegisterItem" -> "https://w3id.org/ogc/rim/RegisterItem-other" [label="related item"];
"https://w3id.org/ogc/rim/RegisterItem" -> "https://w3id.org/ogc/rim/RegisterItem-other" [label="superseded by"];
"https://w3id.org/ogc/rim/RegisterItem" -> "https://w3id.org/ogc/rim/RegisterItem-other" [label="supersedes"];
"https://w3id.org/ogc/rim/RegisterItem" -> "https://w3id.org/ogc/rim/ConceptVersion" [label="realizes"];
"https://w3id.org/ogc/rim/ConceptVersion" -> "https://w3id.org/ogc/rim/Concept" [label="version of"];
}
