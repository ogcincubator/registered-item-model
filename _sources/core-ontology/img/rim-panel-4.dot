digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.42", ranksep="1.0", splines=true];
node [shape=ellipse, fontname="Arial", fontsize=19, color="#48515a", fontcolor="#353c43", penwidth=1.3, margin="0.18,0.12"];
edge [fontname="Arial", fontsize=15, color="#48515a", fontcolor="#24292e", penwidth=1.1, arrowhead=vee, arrowsize=0.75];
"https://w3id.org/ogc/rim/RegisterAction" [label="Register action\n(prov:Activity)", shape=ellipse];
"http://www.w3.org/ns/prov#Agent" [label="prov:Agent", shape=ellipse];
"https://w3id.org/ogc/rim/RegisterActionType" [label="Register action type", shape=ellipse];
"https://w3id.org/ogc/rim/ChangeClassification" [label="Change\nclassification", shape=ellipse];
"https://w3id.org/ogc/rim/RegisterItem" [label="Register item", shape=ellipse];
"https://w3id.org/ogc/rim/RegisterAction" -> "http://www.w3.org/ns/prov#Agent" [label="proposer"];
"https://w3id.org/ogc/rim/RegisterAction" -> "https://w3id.org/ogc/rim/RegisterActionType" [label="action type"];
"https://w3id.org/ogc/rim/RegisterAction" -> "https://w3id.org/ogc/rim/ChangeClassification" [label="change classification"];
"https://w3id.org/ogc/rim/RegisterAction" -> "https://w3id.org/ogc/rim/RegisterItem" [label="applies to"];
"https://w3id.org/ogc/rim/RegisterItem" -> "https://w3id.org/ogc/rim/RegisterAction" [label="has action"];
}
