@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix rim: <https://w3id.org/ogc/rim/>.
@prefix dct: <http://purl.org/dc/terms/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

rim:TextShape a sh:NodeShape;
  sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ).

rim:RegisterSpecificationShape a sh:NodeShape;
  sh:targetClass rim:RegisterSpecification;
  sh:property [
    sh:path dct:title;
    sh:node rim:TextShape;
    sh:minCount 1;
  ];
  sh:property [
    sh:path dct:description;
    sh:node rim:TextShape;
  ];
  sh:property [
    sh:path rim:definesSubstantiveChange;
    sh:node rim:TextShape;
    sh:maxCount 1;
  ];
  sh:property [
    sh:path rim:hasCommitment;
    sh:class rim:Commitment;
  ].

rim:CommitmentShape a sh:NodeShape;
  sh:targetClass rim:Commitment;
  sh:property [
    sh:path rim:commitmentCategory;
    sh:class rim:CommitmentCategory;
    sh:minCount 1;
    sh:maxCount 1;
  ];
  sh:property [
    sh:path dct:description;
    sh:node rim:TextShape;
    sh:minCount 1;
  ].

