ex:valid a rim:ValidityStatus .

ex:published a rim:PublicationStatus .

ex:uc a rim:RegisterItemClass;
  rim:objectIdentifier "urn:uuid:33333333-3333-4333-8333-333333333333"^^xsd:anyURI;
