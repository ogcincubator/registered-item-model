<bblocks://ogc.model.registered-item.geoprocessing-activity-type> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Model ;
    rdfs:label "Geoprocessing Activity Types Profile" ;
    dct:abstract "A profile of the Activity Type Register Profile for geoprocessing activity types: registered sub-classes of geoproc:GeoprocessingActivity, each required to use or generate at least one GeoSPARQL spatial data type."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-09-23T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/registered-item-model/build/generateddocs/json-full/model/registered-item/geoprocessing-activity-type/index.json> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/registered-item-model/build/generateddocs/markdown/model/registered-item/geoprocessing-activity-type/index.md> ],
        [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/registered-item-model/bblock/ogc.model.registered-item.geoprocessing-activity-type> ],
        "Geoprocessing activities (reprojection, clipping, index computation, classification, model inference over imagery) are distinguished from other activities by the kind of data they use and produce. This block adds geoproc:GeoprocessingActivity, a sub-class of prov:Activity that every registered geoprocessing activity type specialises. It also constrains the related PROV object types such a type declares: at least one acttype:usedEntityType or acttype:generatedEntityType must be a GeoSPARQL 1.1 spatial type (geo:SpatialObject or geo:SpatialObjectCollection, or a sub-class of either). Further profiles, such as the ML Activity Types Profile, specialise geoproc:GeoprocessingActivity in turn and add their own constraints."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:hasVersion "0.1" ;
    dct:modified "2026-10-07"^^xsd:date ;
    dct:source <https://docs.ogc.org/is/22-047r1/22-047r1.html>,
        <https://www.w3.org/TR/prov-o/> ;
    skos:closeMatch <https://w3id.org/ogc/rim/geoprocessing/GeoprocessingActivity> ;
    skos:inScheme <https://ogcincubator.github.io/registered-item-model/> ;
    skos:prefLabel "Geoprocessing Activity Types Profile" ;
    skos:topConceptOf <https://ogcincubator.github.io/registered-item-model/> ;
    dcat:keyword "activity type",
        "geoprocessing",
        "provenance",
        "register" ;
    prof:hasResource [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.model.cross-domain.prov> ;
            prof:hasArtifact <https://ogcincubator.github.io/cross-domain-model/_sources/prov/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.model.registered-item.core-ontology> ;
            prof:hasArtifact <https://ogcincubator.github.io/registered-item-model/_sources/core-ontology/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.model.registered-item.geoprocessing-activity-type> ;
            prof:hasArtifact <https://ogcincubator.github.io/registered-item-model/_sources/geoprocessing-activity-type/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo owl:Ontology ;
            dct:format "text/turtle" ;
            prof:hasArtifact <https://ogcincubator.github.io/registered-item-model/build/annotated/model/registered-item/geoprocessing-activity-type/ontology.ttl> ;
            prof:hasRole role:specification ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.model.registered-item.activity-type> ;
            prof:hasArtifact <https://ogcincubator.github.io/registered-item-model/_sources/activity-type/shapes.shacl> ;
            prof:hasRole role:validation ] ;
    prof:isProfileOf <bblocks://ogc.model.registered-item.activity-type> ;
    bblocks:dependsOn <bblocks://ogc.model.cross-domain.geosparql> ;
    bblocks:status <http://www.opengis.net/def/status/under-development> ;
    bblocks:validationPassed false .

<bblocks://ogc.model.registered-item.ml-activity-profile> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Model ;
    rdfs:label "ML Activity Types Profile" ;
    dct:abstract "A profile of the Geoprocessing Activity Types Profile describing machine learning training and inference runs, and registrable ML activity types, using the STAC MLM extension's task, framework/accelerator and input/output vocabulary."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-09-17T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/registered-item-model/build/generateddocs/json-full/model/registered-item/ml-activity-profile/index.json> ],
        [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/registered-item-model/bblock/ogc.model.registered-item.ml-activity-profile> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/registered-item-model/build/generateddocs/markdown/model/registered-item/ml-activity-profile/index.md> ],
        "The STAC Machine Learning Model (MLM) extension describes a model as a static artifact — a STAC Item or Collection with declared inputs, outputs and requirements — but has no notion of a particular run of that model. This block adds that: mlact:MLActivity (with mlact:TrainingActivity and mlact:InferenceActivity sub-types) is a geoproc:GeoprocessingActivity recording one execution, and so can be specialised into ML activity types held in an activity type register. It is also a rim:RegisterAction. In this ecosystem, running a model is itself a governed act — typically the one that adds a derived product to a register as a new rim:RegisterItem — so the run belongs in the same audit trail as any other register action. The activity's task, framework and accelerator are drawn from the MLM extension's own SKOS schemes rather than redefined, and its recorded inputs/outputs (mlact:ActivityInput / mlact:ActivityOutput, both prov:Entity) each declare via dct:conformsTo which of the model's own declared mlm:ModelInput/mlm:ModelOutput specifications they realise. Registered ML activity types must declare at least one mlact:ActivityInput sub-type as a used entity type, and registered inference types at least one mlact:ActivityOutput sub-type as a generated entity type."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:hasVersion "0.1" ;
    dct:modified "2026-10-07"^^xsd:date ;
    dct:source <https://github.com/ogcincubator/bblocks-stac/tree/master/_sources/extensions/mlm-ontology>,
        <https://github.com/stac-extensions/mlm/blob/main/README.md>,
        <https://www.w3.org/TR/prov-o/> ;
    skos:closeMatch <https://w3id.org/ogc/rim/ml-activity/MLActivity> ;
    skos:inScheme <https://ogcincubator.github.io/registered-item-model/> ;
    skos:prefLabel "ML Activity Types Profile" ;
    skos:topConceptOf <https://ogcincubator.github.io/registered-item-model/> ;
    dcat:keyword "MLM",
        "activity type",
        "machine learning",
        "provenance",
        "register" ;
    prof:hasResource [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.model.registered-item.ml-activity-profile> ;
            prof:hasArtifact <https://ogcincubator.github.io/registered-item-model/_sources/ml-activity-profile/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.contrib.stac.extensions.mlm-ontology> ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-stac/_sources/extensions/mlm-ontology/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo owl:Ontology ;
            dct:format "text/turtle" ;
            prof:hasArtifact <https://ogcincubator.github.io/registered-item-model/build/annotated/model/registered-item/ml-activity-profile/ontology.ttl> ;
            prof:hasRole role:specification ] ;
    prof:isProfileOf <bblocks://ogc.model.registered-item.geoprocessing-activity> ;
    bblocks:dependsOn <bblocks://ogc.contrib.stac.extensions.mlm-ontology> ;
    bblocks:status <http://www.opengis.net/def/status/under-development> ;
    bblocks:validationPassed true .

