    bblocks:status <http://www.opengis.net/def/status/under-development> ;
    bblocks:validationPassed true .

<bblocks://ogc.model.registered-item.activity-type> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Model ;
    rdfs:label "Activity Type Register Profile" ;
    dct:abstract "A profile of the Registered Item Model for governed activity type records in the acttype:ActivityType hierarchy, with related PROV object types and an optional plan."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-09-23T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://nielshoffmann.github.io/registered-item-model/bblock/ogc.model.registered-item.activity-type> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://nielshoffmann.github.io/registered-item-model/build/generateddocs/markdown/model/registered-item/activity-type/index.md> ],
        [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://nielshoffmann.github.io/registered-item-model/build/generateddocs/json-full/model/registered-item/activity-type/index.json> ],
        "An activity type register governs activity types with identifiers, statuses and change history. Specific activity type classes specialise acttype:ActivityType, a sub-class of rim:RegisterItem. Registered types may be classes used to type individual activity records; those records also inherit register item requirements. Every activity type record uses acttype:activityTypeItemClass and belongs to the acttype:ActivityType hierarchy through rdf:type. Related entity, agent and activity types and an optional prov:Plan describe the expected activity. Further profiles specialise the root and constrain these related types."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:hasVersion "0.3" ;
    dct:modified "2026-10-23"^^xsd:date ;
    dct:source <https://www.opmw.org/model/p-plan/>,
        <https://www.w3.org/TR/prov-o/> ;
    skos:closeMatch <https://w3id.org/ogc/rim/activity-type/ActivityType> ;
    skos:inScheme <https://nielshoffmann.github.io/registered-item-model/> ;
    skos:prefLabel "Activity Type Register Profile" ;
    skos:topConceptOf <https://nielshoffmann.github.io/registered-item-model/> ;
    dcat:keyword "activity type",
        "plan",
        "provenance",
        "register" ;
    prof:hasResource [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/json" ;
            prof:hasArtifact <https://nielshoffmann.github.io/registered-item-model/build/annotated/model/registered-item/activity-type/schema.json> ;
            prof:hasRole role:schema ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.model.registered-item.activity-type> ;
            prof:hasArtifact <https://nielshoffmann.github.io/registered-item-model/_sources/activity-type/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo owl:Ontology ;
            dct:format "text/turtle" ;
            prof:hasArtifact <https://nielshoffmann.github.io/registered-item-model/build/annotated/model/registered-item/activity-type/ontology.ttl> ;
            prof:hasRole role:specification ],
        [ dct:conformsTo <https://www.w3.org/TR/json-ld11/> ;
            dct:format "application/ld+json" ;
            prof:hasArtifact <https://nielshoffmann.github.io/registered-item-model/build/annotated/model/registered-item/activity-type/context.jsonld> ;
            prof:hasRole role:mapping ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.model.registered-item.core-ontology> ;
            prof:hasArtifact <https://nielshoffmann.github.io/registered-item-model/_sources/core-ontology/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.model.cross-domain.prov> ;
            prof:hasArtifact <https://ogcincubator.github.io/cross-domain-model/_sources/prov/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/yaml" ;
            prof:hasArtifact <https://nielshoffmann.github.io/registered-item-model/build/annotated/model/registered-item/activity-type/schema.yaml> ;
            prof:hasRole role:schema ] ;
    prof:isProfileOf <bblocks://ogc.model.registered-item.rim.register-item-class> ;
    bblocks:dependsOn <bblocks://ogc.model.cross-domain.prov>,
        <bblocks://ogc.model.registered-item.rim.register-item-class> ;
    bblocks:status <http://www.opengis.net/def/status/under-development> ;
    bblocks:validationPassed true .

<bblocks://ogc.model.registered-item.core-ontology> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Model ;
    rdfs:label "Registered Item Model" ;
    dct:abstract "A base RDF and SHACL model for register items, register item classes and register governance metadata, based on ISO 19135:2026."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-09-17T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://nielshoffmann.github.io/registered-item-model/build/generateddocs/markdown/model/registered-item/core-ontology/index.md> ],
        [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://nielshoffmann.github.io/registered-item-model/build/generateddocs/json-full/model/registered-item/core-ontology/index.json> ],
        [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://nielshoffmann.github.io/registered-item-model/bblock/ogc.model.registered-item.core-ontology> ],
        "A register is a catalogue distinguished from a plain dataset by systematic governance: a content information model (register item classes and register items) plus management metadata (identifiers, statuses, actions, roles). ISO 19135:2026 defines one such model, separating a concept plane (meaning) from a content plane (representation) and adding roles, statuses, actions, relations and commitments on top. This block publishes that model as a single base building block so that many registers with different native schemas — a CSV catalogue, the OGC Definitions Server, a GitHub-managed vocabulary, or a Building Blocks register itself — can each map their own fields onto it via a JSON-LD context, and be queried as one graph. Sub-registers are expected to profile this block (null, additive or constrained) rather than invent their own register model."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:hasVersion "0.1" ;
    dct:modified "2026-10-23"^^xsd:date ;
    dct:source <https://github.com/ogcincubator/bblocks-docs/blob/master/design/register-governance.md>,
        <https://www.iso.org/standard/86261.html> ;
    skos:inScheme <https://nielshoffmann.github.io/registered-item-model/> ;
    skos:prefLabel "Registered Item Model" ;
    skos:topConceptOf <https://nielshoffmann.github.io/registered-item-model/> ;
    dcat:keyword "ISO 19135",
        "governance",
        "metadata",
        "register" ;
    prof:hasResource [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.model.registered-item.core-ontology> ;
            prof:hasArtifact <https://nielshoffmann.github.io/registered-item-model/_sources/core-ontology/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo owl:Ontology ;
            dct:format "text/turtle" ;
            prof:hasArtifact <https://nielshoffmann.github.io/registered-item-model/build/annotated/model/registered-item/core-ontology/ontology.ttl> ;
            prof:hasRole role:specification ] ;
    bblocks:status <http://www.opengis.net/def/status/under-development> ;
    bblocks:validationPassed true .

<https://nielshoffmann.github.io/registered-item-model/> a skos:ConceptScheme,
        dcat:Catalog,
        bblocks:BBlocksRegister ;
    rdfs:label "Building Blocks - Registered Item Model" ;
    dct:abstract """A base RDF and SHACL model for register items, register item classes and register
governance metadata, aligned with ISO 19135:2026 (*Geographic information — Registration
and register governance*). Sub-registers profile this model rather than inventing their own.
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:description """A register is a catalogue with systematic governance: a content information model
(what an item looks like) plus management metadata (who governs it, what state it is
in, how it changes). ISO 19135:2026 defines one such register model — separating a
**concept plane** (meaning: concepts and concept versions) from a **content plane**
(representation: register item classes and register items) and adding a governance
layer of roles, statuses, actions and commitments.

This repository publishes that model as a single base [OGC Building
Block](https://ogcincubator.github.io/bblocks-docs/), independent of any one register's
own content schema. Any register — a CSV catalogue, the OGC Definitions Server, a
GitHub-managed vocabulary, or a Building Blocks register itself — maps its own
schema's identifiers, statuses and roles onto this base model via a JSON-LD context,
so that management metadata from otherwise unrelated registers becomes one queryable
graph. A sub-register's rules are expressed as a profile of this base block (null,
additive, or constrained), always validating against it.

Register vs. registry: the **register** is the governed information (items,
identifiers, statuses, roles, processes); the **register system** — often loosely
called the "registry" — is merely the information system it happens to run on. This
model describes the former, independent of the latter.
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:modified "2026-10-23T15:42:19.586333"^^xsd:dateTime ;
    owl:imports <https://ogcincubator.github.io/bblocks-stac/build/register.json>,
        <https://ogcincubator.github.io/cross-domain-model/build/register.json>,
        <https://opengeospatial.github.io/bblocks/register.json> ;
    skos:hasTopConcept <bblocks://ogc.model.registered-item.activity-type>,
        <bblocks://ogc.model.registered-item.core-ontology>,
        <bblocks://ogc.model.registered-item.geoprocessing-activity-types>,
        <bblocks://ogc.model.registered-item.rim.concept-version>,
        <bblocks://ogc.model.registered-item.rim.register>,
        <bblocks://ogc.model.registered-item.rim.register-action>,
        <bblocks://ogc.model.registered-item.rim.register-item-class>,
        <bblocks://ogc.model.registered-item.rim.register-specification>,
        <bblocks://ogc.model.registered-item.rim.registered-item>,
        <bblocks://ogc.model.registered-item.st-ml-activity-types> ;
    skos:prefLabel "Building Blocks - Registered Item Model" ;
    prof:hasResource [ rdfs:label "This Building Blocks Register in RDF Turtle format" ;
            dct:type "text/turtle" ;
            ns1:relation <http://www.iana.org/assignments/relation/self> ;
            ns2:hasTarget <https://nielshoffmann.github.io/registered-item-model/build/bblocks.ttl> ],
        [ rdfs:label "This Building Blocks Register in JSON-LD format" ;
            dct:type "application/ld+json" ;
            ns1:relation <http://www.iana.org/assignments/relation/self> ;
            ns2:hasTarget <https://nielshoffmann.github.io/registered-item-model/build/bblocks.jsonld> ],
        [ rdfs:label "This Building Blocks Register in JSON format" ;
            dct:type "application/json" ;
            ns1:relation <http://www.iana.org/assignments/relation/self> ;
            ns2:hasTarget <https://nielshoffmann.github.io/registered-item-model/build/register.json> ] ;
    foaf:homepage <https://nielshoffmann.github.io/registered-item-model/> ;
    bblocks:hasValidationReport <https://nielshoffmann.github.io/registered-item-model/build/tests/report.html> .

_:N6b49ccc68f3d441da3f852dd5ddcf140 a prov:Agent,
