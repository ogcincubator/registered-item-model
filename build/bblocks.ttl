<bblocks://ogc.model.registered-item.activity-type> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Model ;
    rdfs:label "Activity Type Register Profile" ;
    dct:abstract "A profile of the Registered Item Model for registers whose items are types of prov:Activity, each able to declare the types of PROV entities, agents and activities it relates to and an optional prov:Plan of required steps."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-09-23T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/registered-item-model/bblock/ogc.model.registered-item.activity-type> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/registered-item-model/build/generateddocs/markdown/model/registered-item/activity-type/index.md> ],
        [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/registered-item-model/build/generateddocs/json-full/model/registered-item/activity-type/index.json> ],
        "An activity type register governs a set of activity types — kinds of prov:Activity such as a quality review, a reprojection or a model inference run — with the same identifiers, statuses and change history as any other register item. This block narrows the domain of rim:itemClass for such a register: each item is an acttype:ActivityType, which is simultaneously a rim:RegisterItem and a class declared rdfs:subClassOf prov:Activity, so individual activities are typed directly with the registered item. Each activity type may declare, at the type level, the kinds of entity it uses and generates, the kinds of agent it is associated with and the kinds of activity that inform it, and may point to one prov:Plan (P-Plan recommended) describing its required steps. Further profiles specialise this one — adding a root activity class and constraining the related types its sub-types must declare."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:hasVersion "0.1" ;
    dct:modified "2026-10-07"^^xsd:date ;
    dct:source <https://www.opmw.org/model/p-plan/>,
        <https://www.w3.org/TR/prov-o/> ;
    skos:closeMatch <https://w3id.org/ogc/rim/activity-type/ActivityType> ;
    skos:inScheme <https://ogcincubator.github.io/registered-item-model/> ;
    skos:prefLabel "Activity Type Register Profile" ;
    skos:topConceptOf <https://ogcincubator.github.io/registered-item-model/> ;
    dcat:keyword "activity type",
        "plan",
        "provenance",
        "register" ;
    prof:hasResource [ dct:conformsTo owl:Ontology ;
            dct:format "text/turtle" ;
            prof:hasArtifact <https://ogcincubator.github.io/registered-item-model/build/annotated/model/registered-item/activity-type/ontology.ttl> ;
            prof:hasRole role:specification ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.model.registered-item.core-ontology> ;
            prof:hasArtifact <https://ogcincubator.github.io/registered-item-model/_sources/core-ontology/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.model.registered-item.activity-type> ;
            prof:hasArtifact <https://ogcincubator.github.io/registered-item-model/_sources/activity-type/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.model.cross-domain.prov> ;
            prof:hasArtifact <https://ogcincubator.github.io/cross-domain-model/_sources/prov/shapes.shacl> ;
            prof:hasRole role:validation ] ;
    prof:isProfileOf <bblocks://ogc.model.registered-item.core-ontology> ;
    bblocks:status <http://www.opengis.net/def/status/under-development> ;
    bblocks:validationPassed true .

