@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rim:ConceptSystem a owl:Class ;
    rdfs:label "Concept system" ;
    rdfs:comment "A collection of related concepts maintained by a register's concept plane." ;
    rdfs:isDefinedBy rim: ;
    rdfs:subClassOf skos:ConceptScheme .

rim:accessCommitment a skos:Concept,
        rim:CommitmentCategory ;
    skos:definition "A commitment about access to metadata, to current content, or to historic content."@en ;
    skos:inScheme rim:CommitmentCategoryScheme ;
    skos:prefLabel "access"@en .

rim:actionType a owl:ObjectProperty ;
    rdfs:label "action type" ;
    rdfs:domain rim:RegisterAction ;
    rdfs:isDefinedBy rim: ;
    rdfs:range rim:RegisterActionType .

rim:additionAction a skos:Concept,
        rim:RegisterActionType ;
    skos:definition "A new register item or concept version is added to the register."@en ;
    skos:inScheme rim:RegisterActionTypeScheme ;
    skos:prefLabel "addition"@en .

rim:affectedProperty a owl:ObjectProperty ;
    rdfs:label "affected property" ;
    rdfs:comment "Indicates the property of the register item that the register action affected." ;
    rdfs:domain rim:RegisterAction ;
    rdfs:isDefinedBy rim: ;
    rdfs:range rdf:property .

rim:changeClassification a owl:ObjectProperty ;
    rdfs:label "change classification" ;
    rdfs:domain rim:RegisterAction ;
    rdfs:isDefinedBy rim: ;
    rdfs:range rim:ChangeClassification .

rim:clarifyingChange a skos:Concept,
        rim:ChangeClassification ;
    skos:definition "The change has minor impact, such as an editorial correction, and causes no compatibility issue for downstream users."@en ;
    skos:inScheme rim:ChangeClassificationScheme ;
    skos:prefLabel "clarifying"@en .

rim:commitmentCategory a owl:ObjectProperty ;
    rdfs:label "commitment category" ;
    rdfs:domain rim:Commitment ;
    rdfs:isDefinedBy rim: ;
    rdfs:range rim:CommitmentCategory .

rim:controlBody a owl:ObjectProperty ;
    rdfs:label "control body" ;
    rdfs:comment "Subject-matter experts who decide whether proposed content changes are approved, and who publish and maintain the acceptance criteria for the item classes they govern." ;
    rdfs:domain rim:Register ;
    rdfs:isDefinedBy rim: ;
    rdfs:range prov:Agent .

rim:correctionalChange a skos:Concept,
        rim:ChangeClassification ;
    skos:definition "A correction to the record itself, available only in the most capable ISO 19135:2026 register types."@en ;
    skos:inScheme rim:ChangeClassificationScheme ;
    skos:prefLabel "correctional"@en .

rim:definedIn a owl:ObjectProperty ;
    rdfs:label "defined in" ;
    rdfs:comment "Relates a register item class to the register that defines it. A register item class may be reused across registers; this records where it originates." ;
    rdfs:domain rim:RegisterItemClass ;
    rdfs:isDefinedBy rim: ;
    rdfs:range rim:Register .

rim:definesSubstantiveChange a owl:DatatypeProperty ;
    rdfs:label "defines substantive change" ;
    rdfs:comment "Free-text statement, required by ISO 19135:2026 to be documented in the register specification, of what counts as a substantive (as opposed to clarifying) change for this register." ;
    rdfs:domain rim:RegisterSpecification ;
    rdfs:isDefinedBy rim: ;
    rdfs:range xsd:string .

rim:deletionAction a skos:Concept,
        rim:RegisterActionType ;
    skos:definition "A register item is removed from the register."@en ;
    skos:inScheme rim:RegisterActionTypeScheme ;
    skos:prefLabel "deletion"@en .

rim:functionalIdentifier a owl:DatatypeProperty ;
    rdfs:label "functional identifier" ;
    rdfs:comment "A redirectable identifier: what it resolves to may change over time so that it continues to serve its original intent, for example \"the current version of this concept\"." ;
    rdfs:domain [ owl:unionOf ( rim:Register rim:RegisterItemClass rim:RegisterItem rim:ConceptVersion ) ] ;
    rdfs:isDefinedBy rim: ;
    rdfs:range xsd:anyURI .

rim:hasAction a owl:ObjectProperty ;
    rdfs:label "has action" ;
    rdfs:comment "Relates a register item to a recorded action performed on it." ;
    rdfs:domain rim:RegisterItem ;
    rdfs:isDefinedBy rim: ;
    rdfs:range rim:RegisterAction ;
    owl:inverseOf rim:appliesTo .

rim:hasCommitment a owl:ObjectProperty ;
    rdfs:label "has commitment" ;
    rdfs:domain rim:Register ;
    rdfs:isDefinedBy rim: ;
    rdfs:range rim:Commitment .

rim:hasSpecification a owl:ObjectProperty ;
    rdfs:label "has specification" ;
    rdfs:comment "Relates a register to the register specification that documents its governance." ;
    rdfs:domain rim:Register ;
    rdfs:isDefinedBy rim: ;
    rdfs:range rim:RegisterSpecification .

rim:inRegister a owl:ObjectProperty ;
    rdfs:label "in register" ;
    rdfs:comment "Relates a register item to the register that holds it." ;
    rdfs:domain rim:RegisterItem ;
    rdfs:isDefinedBy rim: ;
    rdfs:range rim:Register .

rim:invalid a skos:Concept,
        rim:ValidityStatus ;
    skos:definition "The register item or concept version is not currently in force."@en ;
    skos:inScheme rim:ValidityStatusScheme ;
    skos:prefLabel "invalid"@en .

rim:invalidationAction a skos:Concept,
        rim:RegisterActionType ;
    skos:definition "A register item or concept version is marked as no longer in force."@en ;
    skos:inScheme rim:RegisterActionTypeScheme ;
    skos:prefLabel "invalidation"@en .

rim:isDeleted a owl:DatatypeProperty ;
    rdfs:label "is deleted" ;
    rdfs:comment "Optional flag; the register owner decides and documents in the register specification whether this register uses deletion at all." ;
    rdfs:domain [ owl:unionOf ( rim:RegisterItem rim:ConceptVersion ) ] ;
    rdfs:isDefinedBy rim: ;
    rdfs:range xsd:boolean .

rim:isRedacted a owl:DatatypeProperty ;
    rdfs:label "is redacted" ;
    rdfs:comment "Optional flag; the register owner decides and documents in the register specification whether this register uses redaction at all." ;
    rdfs:domain [ owl:unionOf ( rim:RegisterItem rim:ConceptVersion ) ] ;
    rdfs:isDefinedBy rim: ;
    rdfs:range xsd:boolean .

rim:itemClass a owl:ObjectProperty ;
    rdfs:label "item class" ;
    rdfs:comment "Relates a register item to the register item class it belongs to. Every register item has exactly one item class; validation rules are attached at this level." ;
    rdfs:domain rim:RegisterItem ;
    rdfs:isDefinedBy rim: ;
    rdfs:range rim:RegisterItemClass .

rim:objectIdentifier a owl:DatatypeProperty ;
    rdfs:label "object identifier" ;
    rdfs:comment "An identifier permanently bound to one object; it never redirects and never comes to refer to something else." ;
    rdfs:domain [ owl:unionOf ( rim:Register rim:RegisterItemClass rim:RegisterItem rim:ConceptVersion ) ] ;
    rdfs:isDefinedBy rim: ;
    rdfs:range xsd:anyURI .

rim:persistenceCommitment a skos:Concept,
        rim:CommitmentCategory ;
    skos:definition "A commitment about identifier persistence, metadata persistence and retention, content persistence and retention, or historic persistence with full traceability."@en ;
    skos:inScheme rim:CommitmentCategoryScheme ;
    skos:prefLabel "persistence"@en .

rim:proposer a owl:ObjectProperty ;
    rdfs:label "proposer" ;
    rdfs:comment "Party that proposed a register action: may clarify on request and may withdraw the proposal at any time before a decision is made. Also called \"register change proposer\" or, in editions of ISO 19135 before 2026, \"submitting organization\"." ;
    rdfs:domain rim:RegisterAction ;
    rdfs:isDefinedBy rim: ;
    rdfs:range prov:Agent ;
    rdfs:subPropertyOf prov:wasAssociatedWith .

rim:publicationStatus a owl:ObjectProperty ;
    rdfs:label "publication status" ;
    rdfs:domain [ owl:unionOf ( rim:RegisterItem rim:ConceptVersion ) ] ;
    rdfs:isDefinedBy rim: ;
    rdfs:range rim:PublicationStatus .

rim:publishAction a skos:Concept,
        rim:RegisterActionType ;
    skos:definition "A register item or concept version is made visible to register users."@en ;
    skos:inScheme rim:RegisterActionTypeScheme ;
    skos:prefLabel "publish"@en .

rim:published a skos:Concept,
        rim:PublicationStatus ;
    skos:definition "The register item or concept version is currently visible to register users."@en ;
    skos:inScheme rim:PublicationStatusScheme ;
    skos:prefLabel "published"@en .

rim:realizes a owl:ObjectProperty ;
    rdfs:label "realizes" ;
    rdfs:comment "Relates a register item, in the content plane, to the concept version it represents, in the concept plane. Separating the two lets a register evolve what something means independently of how it is represented." ;
    rdfs:domain rim:RegisterItem ;
    rdfs:isDefinedBy rim: ;
    rdfs:range rim:ConceptVersion .

rim:redactionAction a skos:Concept,
        rim:RegisterActionType ;
    skos:definition "Content is removed from a register item for legal or privacy reasons, while the record of the item is retained."@en ;
    skos:inScheme rim:RegisterActionTypeScheme ;
    skos:prefLabel "redaction"@en .

rim:registerManager a owl:ObjectProperty ;
    rdfs:label "register manager" ;
    rdfs:comment "Party responsible for content governance: receives proposals, verifies eligibility, forwards them to the control body, implements approved changes and informs proposers. Procedural, not a content-decision role." ;
    rdfs:domain rim:Register ;
    rdfs:isDefinedBy rim: ;
    rdfs:range prov:Agent .

rim:registerOwner a owl:ObjectProperty ;
    rdfs:label "register owner" ;
    rdfs:comment "Party with ultimate responsibility for the register: creates the register specification, appoints the other roles, sets proposer eligibility, access terms, process time limits and the appeal procedure." ;
    rdfs:domain rim:Register ;
    rdfs:isDefinedBy rim: ;
    rdfs:range prov:Agent .

rim:registerSystemManager a owl:ObjectProperty ;
    rdfs:label "register system manager" ;
    rdfs:comment "Party that manages the register system (the information system), as distinct from the register's content. Called \"registry manager\" in editions of ISO 19135 before 2026." ;
    rdfs:domain rim:Register ;
    rdfs:isDefinedBy rim: ;
    rdfs:range prov:Agent .

rim:registerUser a owl:ObjectProperty ;
    rdfs:label "register user" ;
    rdfs:comment "A party recognised as accessing the register's content, potentially at a differentiated access level." ;
    rdfs:domain rim:Register ;
    rdfs:isDefinedBy rim: ;
    rdfs:range prov:Agent .

rim:runsOn a owl:ObjectProperty ;
    rdfs:label "runs on" ;
    rdfs:comment "Relates a register to the register system that hosts it." ;
    rdfs:domain rim:Register ;
    rdfs:isDefinedBy rim: ;
    rdfs:range rim:RegisterSystem .

rim:substantiveChange a skos:Concept,
        rim:ChangeClassification ;
    skos:definition "The change has major impact on use, typically altering semantics or technical meaning; downstream users are obliged to act."@en ;
    skos:inScheme rim:ChangeClassificationScheme ;
    skos:prefLabel "substantive"@en .

rim:supersededBy a owl:ObjectProperty ;
    rdfs:label "superseded by" ;
    rdfs:comment "Relates a register item to the register item that replaces it. Supersession is a relation, not a status: a superseded item may still be valid." ;
    rdfs:domain rim:RegisterItem ;
    rdfs:isDefinedBy rim: ;
    rdfs:range rim:RegisterItem ;
    rdfs:subPropertyOf rim:relatedItem ;
    owl:inverseOf rim:supersedes .

rim:supersessionAction a skos:Concept,
        rim:RegisterActionType ;
    skos:definition "A register item or concept version is replaced by another, recorded as a relation rather than a status."@en ;
    skos:inScheme rim:RegisterActionTypeScheme ;
    skos:prefLabel "supersession"@en .

rim:transparencyCommitment a skos:Concept,
        rim:CommitmentCategory ;
    skos:definition "A commitment about the transparency of metadata, of content, or of history."@en ;
    skos:inScheme rim:CommitmentCategoryScheme ;
    skos:prefLabel "transparency"@en .

rim:unpublishAction a skos:Concept,
        rim:RegisterActionType ;
    skos:definition "A register item or concept version is made no longer visible to register users, without affecting its validity."@en ;
    skos:inScheme rim:RegisterActionTypeScheme ;
    skos:prefLabel "unpublish"@en .

rim:unpublished a skos:Concept,
        rim:PublicationStatus ;
    skos:definition "The register item or concept version is not currently visible to register users. Combined with a valid validity status, this is what earlier editions of ISO 19135 called \"retired\"."@en ;
    skos:inScheme rim:PublicationStatusScheme ;
    skos:prefLabel "unpublished"@en .

rim:valid a skos:Concept,
        rim:ValidityStatus ;
    skos:definition "The register item or concept version is currently in force."@en ;
    skos:inScheme rim:ValidityStatusScheme ;
    skos:prefLabel "valid"@en .

rim:validatedBy a owl:ObjectProperty ;
    rdfs:label "validated by" ;
    rdfs:comment "Points from a register item class to the executable rule set (for example a SHACL shape published as an OGC Building Block) that expresses its data requirements." ;
    rdfs:domain rim:RegisterItemClass ;
    rdfs:isDefinedBy rim: ;
    rdfs:range rdfs:Resource .

rim:validityStatus a owl:ObjectProperty ;
    rdfs:label "validity status" ;
    rdfs:domain [ owl:unionOf ( rim:RegisterItem rim:ConceptVersion ) ] ;
    rdfs:isDefinedBy rim: ;
    rdfs:range rim:ValidityStatus .

rim:version a owl:DatatypeProperty ;
    rdfs:label "version" ;
    rdfs:comment "The version designation of a concept version, as the register's own versioning scheme (documented in its register specification) writes it." ;
    rdfs:domain rim:ConceptVersion ;
    rdfs:isDefinedBy rim: ;
    rdfs:range xsd:string .

rim:versionOf a owl:ObjectProperty ;
    rdfs:label "version of" ;
    rdfs:domain rim:ConceptVersion ;
    rdfs:isDefinedBy rim: ;
    rdfs:range rim:Concept .

rim:Concept a owl:Class ;
    rdfs:label "Concept" ;
    rdfs:comment "A unit of meaning, independent of how it is represented. Use skos:inScheme to relate a concept to its rim:ConceptSystem, and skos:prefLabel/skos:definition for its label and definition." ;
    rdfs:isDefinedBy rim: ;
    rdfs:subClassOf skos:Concept .

rim:RegisterSystem a owl:Class ;
    rdfs:label "Register system" ;
    rdfs:comment "The information system a register runs on. Called a \"registry\" in editions of ISO 19135 before 2026. Distinct from the register itself, so that custody transfer, mirroring or platform migration do not change what the register is." ;
    rdfs:isDefinedBy rim: .

rim:appliesTo a owl:ObjectProperty ;
    rdfs:label "applies to" ;
    rdfs:comment "Relates a register action to the register item it acted upon." ;
    rdfs:domain rim:RegisterAction ;
    rdfs:isDefinedBy rim: ;
    rdfs:range rim:RegisterItem .

rim:supersedes a owl:ObjectProperty ;
    rdfs:label "supersedes" ;
    rdfs:domain rim:RegisterItem ;
    rdfs:isDefinedBy rim: ;
    rdfs:range rim:RegisterItem ;
    rdfs:subPropertyOf rim:relatedItem .

rim:Commitment a owl:Class ;
    rdfs:label "Commitment" ;
    rdfs:comment "A specific, documented promise a register makes to its users, against which it can be assessed. Use dct:description for the promise text." ;
    rdfs:isDefinedBy rim: .

rim:PublicationStatusScheme a skos:ConceptScheme ;
    rdfs:comment "The two values of the required publication concern (ISO 19135:2026 §4), independent of validity status." ;
    skos:prefLabel "Publication status"@en .

rim:RegisterSpecification a owl:Class ;
    rdfs:label "Register specification" ;
    rdfs:comment "The document that states a register's purpose, scope, roles, processes, content requirements, identifier and versioning schemes, proposer eligibility criteria, and the register's definition of a substantive change. The single most important artefact in the ISO 19135:2026 model." ;
    rdfs:isDefinedBy rim: .

rim:ValidityStatusScheme a skos:ConceptScheme ;
    rdfs:comment "The two values of the required validity concern (ISO 19135:2026 §4). A register may not define further values for this concern." ;
    skos:prefLabel "Validity status"@en .

rim:relatedItem a owl:ObjectProperty ;
    rdfs:label "related item" ;
    rdfs:comment "Generic, extensible relation between two register items. Registers define more specific relations (for example rim:supersededBy, or their own) as sub-properties of this one." ;
    rdfs:domain rim:RegisterItem ;
    rdfs:isDefinedBy rim: ;
    rdfs:range rim:RegisterItem .

rim:ChangeClassificationScheme a skos:ConceptScheme ;
    rdfs:comment "How a register action's impact on downstream users is classified (ISO 19135:2026 §4). The register specification must document, per register, what counts as substantive." ;
    skos:prefLabel "Change classification"@en .

rim:CommitmentCategoryScheme a skos:ConceptScheme ;
    rdfs:comment "The three groups of promise a register may make to its users (ISO 19135:2026 §9)." ;
    skos:prefLabel "Commitment category"@en .

rim:PublicationStatus a owl:Class ;
    rdfs:label "Publication status" ;
    rdfs:comment "Whether a register item or concept version is currently published (visible) or unpublished. Required, and independent of validity — a valid item need not be published, and what earlier editions called \"retired\" is the combination valid + unpublished." ;
    rdfs:isDefinedBy rim: ;
    rdfs:subClassOf skos:Concept .

rim:ValidityStatus a owl:Class ;
    rdfs:label "Validity status" ;
    rdfs:comment "Whether a register item or concept version is currently valid or invalid. Required." ;
    rdfs:isDefinedBy rim: ;
    rdfs:subClassOf skos:Concept .

rim:ChangeClassification a owl:Class ;
    rdfs:label "Change classification" ;
    rdfs:comment "Whether a change is substantive (major impact on use, typically altering semantics), clarifying/non-substantive (minor, editorial), or correctional (available only in the most capable register types, for correcting the record itself). The register specification must document what counts as substantive for that register." ;
    rdfs:isDefinedBy rim: ;
    rdfs:subClassOf skos:Concept .

rim:CommitmentCategory a owl:Class ;
    rdfs:label "Commitment category" ;
    rdfs:comment "One of the three groups of commitment a register may make: access; persistence, integrity and traceability; or transparency." ;
    rdfs:isDefinedBy rim: ;
    rdfs:subClassOf skos:Concept .

rim:RegisterItemClass a owl:Class ;
    rdfs:label "Register item class" ;
    rdfs:comment "A defined abstraction of a set of register items sharing common characteristics. Carries the data requirements for those items; this is the unit that validation rules attach to." ;
    rdfs:isDefinedBy rim: .

rim:RegisterAction a owl:Class ;
    rdfs:label "Register action" ;
    rdfs:comment "A defined, recorded way in which register content changes. Every decision — automated or human — produces a retained record: who or what decided, under which rule set version, when, and on what justification." ;
    rdfs:isDefinedBy rim: ;
    rdfs:subClassOf prov:Activity .

rim:RegisterActionTypeScheme a skos:ConceptScheme ;
    rdfs:comment "The defined ways register content changes (ISO 19135:2026 §4). Extensible: a register may define further action types in its register specification." ;
    skos:prefLabel "Register action type"@en .

rim:RegisterActionType a owl:Class ;
    rdfs:label "Register action type" ;
    rdfs:comment "The kind of change a register action makes: addition, publication, unpublication, invalidation, supersession, redaction or deletion. Extensible; a register may define further action types." ;
    rdfs:isDefinedBy rim: ;
    rdfs:subClassOf skos:Concept .

rim:ConceptVersion a owl:Class ;
    rdfs:label "Concept version" ;
    rdfs:comment "A version of a concept. Concept versions, not concepts themselves, carry validity and publication status: a concept's meaning can be stable while a particular version of it is superseded." ;
    rdfs:isDefinedBy rim: .

rim:Register a owl:Class ;
    rdfs:label "Register" ;
    rdfs:comment "A managed collection of information together with the processes that govern it. A register is distinguished from a plain dataset or database by being governed through defined processes (ISO 19135:2026)." ;
    rdfs:isDefinedBy rim: .

rim:RegisterItem a owl:Class ;
    rdfs:label "Register item" ;
    rdfs:comment "The concrete data held in a register's content plane. Realises a concept version where the register maintains a concept plane; stands alone, with its own name and definition, in a content-only register." ;
    rdfs:isDefinedBy rim: .

rim: a owl:Ontology ;
    dct:creator "Rob Atkinson, OGC" ;
    dct:description "A base RDF/OWL and SHACL model for register items, register item classes and register governance metadata, aligned with ISO 19135:2026 (Geographic information — Registration and register governance)." ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dct:title "Registered Item Model" .

