{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ISO 19135 Register Specification",
  "description": "The document stating a register's purpose, scope, roles, processes, rules and commitments (ISO 19135:2026). `type` is not pinned so that a sub-register may use its own term.",
  "type": "object",
  "required": [
    "id",
    "type",
    "title"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uri",
      "x-jsonld-id": "@id"
    },
    "type": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      ],
      "x-jsonld-id": "@type"
    },
    "title": {
      "type": "string",
      "x-jsonld-id": "http://purl.org/dc/terms/title"
    },
    "description": {
      "type": "string",
      "x-jsonld-id": "http://purl.org/dc/terms/description"
    },
    "definesSubstantiveChange": {
      "description": "What counts as a substantive (not merely clarifying) change for this register.",
      "type": "string",
      "x-jsonld-id": "https://w3id.org/ogc/rim/definesSubstantiveChange"
    },
    "hasCommitment": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "commitmentCategory",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uri",
            "x-jsonld-id": "@id"
          },
          "type": {
            "const": "Commitment",
            "x-jsonld-id": "@type"
          },
          "commitmentCategory": {
            "enum": [
              "access",
              "persistence",
              "transparency"
            ],
            "x-jsonld-id": "https://w3id.org/ogc/rim/commitmentCategory",
            "x-jsonld-type": "@vocab"
          },
          "description": {
            "type": "string",
            "x-jsonld-id": "http://purl.org/dc/terms/description"
          }
        }
      },
      "x-jsonld-id": "https://w3id.org/ogc/rim/hasCommitment",
      "x-jsonld-type": "@id"
    }
  },
  "additionalProperties": true,
