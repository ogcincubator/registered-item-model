{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ISO 19135 Register Action",
  "description": "A recorded, governed change to register content (ISO 19135:2026), a prov:Activity: what kind of change, how it is classified, which item it applied to, who proposed it, when. `type` is not pinned so that a sub-register may use its own term.",
  "type": "object",
  "required": [
    "id",
    "type",
    "actionType"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uri",
      "x-jsonld-id": "@id"
    },
    "type": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      ],
      "x-jsonld-id": "@type"
    },
    "actionType": {
      "enum": [
        "addition",
        "publish",
        "unpublish",
        "invalidation",
        "supersession",
        "redaction",
        "deletion"
      ],
      "x-jsonld-id": "https://w3id.org/ogc/rim/actionType",
      "x-jsonld-type": "@vocab"
    },
    "changeClassification": {
      "enum": [
        "substantive",
        "clarifying",
        "correctional"
      ],
      "x-jsonld-id": "https://w3id.org/ogc/rim/changeClassification",
      "x-jsonld-type": "@vocab"
    },
    "appliesTo": {
      "description": "The register item acted upon (an IRI or an embedded node).",
      "$ref": "#/$defs/ref",
      "x-jsonld-id": "https://w3id.org/ogc/rim/appliesTo",
      "x-jsonld-type": "@id"
    },
    "proposer": {
      "$ref": "#/$defs/ref",
      "x-jsonld-id": "https://w3id.org/ogc/rim/proposer",
      "x-jsonld-type": "@id"
    },
    "wasAssociatedWith": {
      "$ref": "#/$defs/refs",
      "x-jsonld-id": "http://www.w3.org/ns/prov#wasAssociatedWith",
      "x-jsonld-type": "@id"
    },
    "startedAtTime": {
      "type": "string",
      "format": "date-time",
      "x-jsonld-id": "http://www.w3.org/ns/prov#startedAtTime",
      "x-jsonld-type": "http://www.w3.org/2001/XMLSchema#dateTime"
    },
    "endedAtTime": {
      "type": "string",
      "format": "date-time",
      "x-jsonld-id": "http://www.w3.org/ns/prov#endedAtTime",
      "x-jsonld-type": "http://www.w3.org/2001/XMLSchema#dateTime"
    },
    "description": {
      "type": "string",
      "x-jsonld-id": "http://purl.org/dc/terms/description"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "ref": {
      "oneOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "format": "uri",
              "x-jsonld-id": "@id"
            }
          }
        }
      ]
    },
    "refs": {
      "oneOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          }
        }
      ]
    }
  },
