  "hasConcepts": [
    {
      "itemIdentifier": "ogc.model.registered-item.activity-type",
      "name": "Activity Type Register Profile",
      "group": "Example: Activity Types",
      "highlighted": true,
      "title": "Registers of prov:Activity types, profiled from the Registered Item Model",
      "abstract": "A profile of the Registered Item Model for registers whose items are types of prov:Activity, each able to declare the types of PROV entities, agents and activities it relates to and an optional prov:Plan of required steps.",
      "description": "An activity type register governs a set of activity types \u2014 kinds of prov:Activity such as a quality review, a reprojection or a model inference run \u2014 with the same identifiers, statuses and change history as any other register item. This block narrows the domain of rim:itemClass for such a register: each item is an acttype:ActivityType, which is simultaneously a rim:RegisterItem and a class declared rdfs:subClassOf prov:Activity, so individual activities are typed directly with the registered item. Each activity type may declare, at the type level, the kinds of entity it uses and generates, the kinds of agent it is associated with and the kinds of activity that inform it, and may point to one prov:Plan (P-Plan recommended) describing its required steps. Further profiles specialise this one \u2014 adding a root activity class and constraining the related types its sub-types must declare.",
      "status": "under-development",
      "version": "0.1",
      "itemClass": "model",
      "isProfileOf": [
        "bblocks://ogc.model.registered-item.core-ontology"
      ],
      "concept": [
        "https://w3id.org/ogc/rim/activity-type/ActivityType"
